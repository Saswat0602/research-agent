{
  "name": "research-agent",
  "version": "1.0.0",
  "description": "Provider-agnostic research agent built with LangChain, LangGraph, Google Gemini, and Ollama",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "serve": "tsx src/api/server.ts",
    "test": "node --import tsx --test 'tests/**/*.test.ts'"
  },
  "keywords": [
    "ai-agent",
    "langchain",
    "langgraph",
    "gemini",
    "ollama",
    "research-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.0",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.2.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.11.1",
    "langchain": "^1.2.0",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
