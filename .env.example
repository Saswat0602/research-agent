# Model Provider Selection: "gemini" | "ollama" | "openai"
MODEL_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Persistence (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/research_agent?schema=public"

# Redis Cache (Fast Search Deduplication & State Cache)
REDIS_URL="redis://localhost:6379"

# Search Tool Configuration
TAVILY_API_KEY=

# Agent Execution Limits
MAX_RESEARCH_LOOPS=3

# Microservice API Port
PORT=3001
